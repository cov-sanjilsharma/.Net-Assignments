@model List<Product>
<table class=" table-bordered" cellpadding="5">
    <tr>
        <th>Product ID</th>
        <th>Product Name</th>
          <th>Product Price</th>
        <th>Product Quantity</th>
    </tr>
   
        @foreach(var product in Model)
        {
        <tr>
            <td>@product.Id</td>
            <td>@product.Name</td>
            <td>@product.Price</td>
            <td>@product.Quantity</td
        </tr>
        }
   
</table>