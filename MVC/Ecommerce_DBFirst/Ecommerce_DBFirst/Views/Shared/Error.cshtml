@model ErrorViewModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<div class="text-center" style="padding: 60px 0;">
    <h1>Oops! Something went wrong on our end.</h1>
    <p class="lead">We're sorry for the inconvenience. Our team has been notified and is looking into it.</p>
    <a href="/" class="btn btn-primary">Go back to Home</a>
</div>

@if (Model.ShowRequestId)
{
    <p class="text-muted text-center">
        Reference ID: <code>@Model.RequestId</code>
    </p>
}