@model List<ProductDTO>

<table border="1" cellpadding="5">
    <tr>
        <th>Product Id</th>
        <th>Product Name</th>
        <th>Price</th>
        <th>Stock Quantity</th>
        <th>Category Name</th>
    </tr>
    @foreach (var product in Model)
    {
        <tr id="row-@product.ProductId">
            <td>@product.ProductId</td>
            <td>@product.ProductName</td>
            <td>@product.Price</td>
            <td>@product.StockQuantit</td>
            <td>@product.CategoryName</td>
            <td> <a href="/Details/@product.ProductId">Product Details</a> </td>
            @if (User.IsInRole("Admin"))
            {
                <td> <a href="/UpdateProduct/@product.ProductId">Edit Product Details</a> </td>
                <td> <button class="btn-delete" data-id="@product.ProductId">Delete Product</button> </td>
            }
        </tr>
    }
</table>