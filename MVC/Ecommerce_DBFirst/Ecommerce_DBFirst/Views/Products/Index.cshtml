@model List<ProductDTO>

<h2>@ViewBag.PageTitle</h2>

<br />

@if (TempData["SuccessMessage"] != null)
{
    <p style="color:green;">@TempData["SuccessMessage"]</p>
}

@if (ViewBag.ErrorMessage != null)
{
    <div style="color:red; font-weight:bold;">
        @ViewBag.ErrorMessage
    </div>
}
<br />

<form id="filterForm" method="get" action="/">
    <input type="text" id="search" name="search" placeholder="Search by Product Name" />

    <select id="sortBy" name="sortBy">
        <option value="">-- Sort By --</option>
        <option value="price">Price (Low to High)</option>
    </select>

    <select id="categoryId" name="categoryId">
        <option value="">-- All Categories --</option>
        @foreach (var cat in ViewBag.Categories)
        {
            <option value="@cat.CategoryId">@cat.CategoryName</option>
        }
    </select>

    <button type="submit">Apply</button>
    <a href="/" id="clearFilters">Clear Filters</a>
</form>

<br />

<div id="productsTable">
    @await Html.PartialAsync("_ProductsTable", Model)
</div>

@if (User.IsInRole("Admin"))
{
    <a href="/AddProduct">Add New Product</a>
}

@section Scripts {
    <script>
        $(document).ready(function () {

            function loadProducts() {
                $.ajax({
                    url: '/',
                    type: 'GET',
                    data: {
                        search: $('#search').val(),
                        sortBy: $('#sortBy').val(),
                        categoryId: $('#categoryId').val()
                    },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (html) {
                        $('#productsTable').html(html);
                    },
                    error: function () {
                        alert('Failed to load products.');
                    }
                });
            }

            // "Apply" button → AJAX instead of full page reload
            $('#filterForm').submit(function (e) {
                e.preventDefault();
                loadProducts();
            });

            // Live search: fires automatically as you type (waits 400ms after you stop typing)
            var searchTimer;
            $('#search').on('keyup', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(loadProducts, 400);
            });

            // Auto-apply when dropdowns change
            $('#sortBy, #categoryId').on('change', function () {
                loadProducts();
            });

            // Clear filters without a full reload
            $('#clearFilters').click(function (e) {
                e.preventDefault();
                $('#search').val('');
                $('#sortBy').val('');
                $('#categoryId').val('');
                loadProducts();
            });

            // Delete button — IMPORTANT: uses event delegation ($(document).on),
            // not $('.btn-delete').click(), because rows get replaced by AJAX
            // and a direct binding wouldn't attach to the new rows.
            $(document).on('click', '.btn-delete', function () {
                if (!confirm('Are you sure you want to delete this product?')) return;

                var id = $(this).data('id');

                $.ajax({
                    url: '/DeleteProduct/' + id,
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (response) {
                        if (response.success) {
                            $('#row-' + id).fadeOut(300, function () {
                                $(this).remove();
                            });
                        }
                    },
                    error: function () {
                        alert('Failed to delete product. Please try again.');
                    }
                });
            });
        });
    </script>
}